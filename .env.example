# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# Neon — branch "dev" para desenvolvimento, "production" na Vercel.
# Com pooler (host contém "-pooler"): usada pela aplicação.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Sem pooler: usada pelas migrações do drizzle-kit.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Modo de simulação (DevToolbar + /api/dev). Ligado por padrão em desenvolvimento;
# em produção fica desligado a menos que os dois sejam "true" (ex.: um preview de testes).
# NEXT_PUBLIC_DEVTOOLS=true
# DEV_TOOLS=true

# Cloudflare R2 (sem estas variáveis o sistema roda em modo demonstração).
# Use um bucket separado para desenvolvimento. Token: Object Read & Write só neste bucket.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="festinha-dev"

# Mercado Pago (Checkout Pro). Sem MP_ACCESS_TOKEN o checkout usa o simulador (/simulador-mp).
# Use as credenciais de TESTE em desenvolvimento e no preview.
MP_ACCESS_TOKEN=""
# "Assinatura secreta" dos webhooks (painel do MP → Webhooks). Obrigatória em produção.
MP_WEBHOOK_SECRET=""
# Opcional: URL pública do webhook (ex.: túnel em desenvolvimento: https://xxxx.trycloudflare.com/api/webhooks/mercadopago).
# MP_NOTIFICATION_URL=""
# Opcional: origem pública do site (senão usa a da própria requisição).
# APP_URL=""
# Vercel Cron da conciliação (a Vercel envia Authorization: Bearer CRON_SECRET).
# CRON_SECRET=""

# Emails (Resend). Sem RESEND_API_KEY os emails ficam só na email_outbox (DevToolbar).
RESEND_API_KEY=""
# Remetente (domínio verificado no Resend).
EMAIL_FROM="Festinhas <contato@seu-dominio.com.br>"
# Para onde vão as respostas dos clientes.
EMAIL_REPLY_TO=""
# Desenvolvimento/preview: TODOS os emails vão para este endereço (não defina em produção).
EMAIL_TO_OVERRIDE=""
