# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# Neon — branch "dev" para desenvolvimento, "production" na Vercel.
# Com pooler (host contém "-pooler"): usada pela aplicação.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Sem pooler: usada pelas migrações do drizzle-kit.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Modo de simulação (DevToolbar + /api/dev). Ligado por padrão em desenvolvimento;
# em produção fica desligado a menos que os dois sejam "true" (ex.: um preview de testes).
# NEXT_PUBLIC_DEVTOOLS=true
# DEV_TOOLS=true
